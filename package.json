{
  "name": "n-file-system",
  "version": "1.0.0",
  "description": "基于 Node.js + Express + Multer + SQLite 的文件管理系统",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build:docker": "docker build -t n-file-system:latest . && docker save -o n-file-system.tar n-file-system:latest"
  },
  "keywords": [
