# 通用配置模板。首次运行时复制为 .env，并至少填写 JWT_SECRET。

# JWT 签名密钥，必须是至少 32 字节的随机字符串；不要提交真实密钥。
JWT_SECRET=

# 邮箱验证码 HMAC 密钥，必须是至少 32 字节且与 JWT_SECRET 不同的随机字符串。
AUTH_CODE_SECRET=

# 服务监听端口。Docker 部署时容器内外统一使用此端口。
PORT=6001

# 运行环境：development 或 production。
NODE_ENV=development

# SQLite 数据目录和物理文件目录。本地运行使用相对路径即可。
DATA_DIR=./data
UPLOAD_DIR=./uploads

# 登录 Token 有效期，支持 jsonwebtoken 的时间格式，例如 2h、7d、30d。
TOKEN_EXPIRES_IN=7d

# 是否开放用户注册。公开部署建议保持 false。
ALLOW_REGISTER=false

# SMTP 邮件服务。生产环境必须正确配置并通过启动连接检查。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=nFileSystem <no-reply@example.com>

# Express 可信代理配置；无反向代理时保持 false，有一层可信代理时可设为 1。
TRUST_PROXY=false

# SQLite 等待锁释放的最长时间，单位毫秒。
SQLITE_BUSY_TIMEOUT_MS=5000

# 单次上传文件数、单文件字节数和单次请求总字节数限制。
MAX_UPLOAD_FILES=20
MAX_FILE_SIZE_BYTES=52428800
MAX_UPLOAD_BYTES=1048576000

# 同时处理的上传请求数，以及每个用户的逻辑文件配额；配额为 0 表示不限制。
MAX_UPLOAD_CONCURRENCY=2
USER_QUOTA_BYTES=10737418240

# 上传后磁盘必须保留的可用空间，单位字节；开发环境可设为 0。
MIN_FREE_BYTES=268435456

# 目录分页大小、最大文件夹深度和临时文件保留时间。
DRIVE_PAGE_SIZE=200
THUMBNAIL_CONCURRENCY=2
MAX_FOLDER_DEPTH=128
STALE_TEMP_MAX_AGE_MS=86400000

# 登录/注册接口限流：窗口内最大尝试次数和窗口时长（毫秒）。
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
